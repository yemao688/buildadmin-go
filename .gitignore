# 通过 Git 部署项目至线上时建议删除的忽略规则
/vendor
/public/*.lock
/public/index.html
/public/assets
/public/favicon.ico

# 通过 Git 部署项目至线上时可以考虑删除的忽略规则
pnpm-lock.yaml
package-lock.json
yarn.lock

# common
node_modules
dist
.DS_Store

# Log files
*.log

# Editor directories and files
.idea
.vscode

# Other
*.css.map
*.local

.env
/configs/config.yaml

# Slim: upstream source clones for comparison
/.slim/

# 为 i18n Ally（VSCode 插件）生成的语言包索引（执行 dev 命令时自动生成）
/web/src/lang/*.json

# tsc/vue-tsc 误发射的编译副产物（web 前端为纯 TS 源码，不受版本控制的 .js）
/web/**/*.js
.buildadmin-crud-*
