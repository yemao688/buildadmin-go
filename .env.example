# 部署层变量模板：cp .env.example .env 后按需修改，make / docker compose 共用同一份 .env。
# 应用 YAML 配置在 configs/config.yaml（由 setup 安装器生成，不进 .env），这里只放部署变量。

# ---- 运行 / 宿主映射 ----
# APP_PORT 只是宿主机映射端口，容器内端口固定 9900（镜像 EXPOSE 与代码兜底一致）。
APP_PORT               = 9900
# APP_TIME_ZONE 由 docker compose 注入容器，应用运行时读取。
APP_TIME_ZONE          = Asia/Shanghai
# 容器内存上限（compose mem_limit），按宿主规格调整。
COMPOSE_MEM_LIMIT      = 1g

# ---- 镜像推送 ----
# compose project 名，同时作为镜像名主体的最后一段。
COMPOSE_PROJECT_NAME   = buildadmin-go
REGISTRY               = registry.example.com
# 可空：空 = <REGISTRY>/<COMPOSE_PROJECT_NAME>；ACR / Harbor 需填项目名 → <REGISTRY>/<命名空间>/<镜像名>。
REGISTRY_NAMESPACE     =
REGISTRY_USER          =
REGISTRY_PASSWORD      =
# make push 的目标平台（多架构 manifest list）；make build 只用宿主单架构，不受此项影响。
BUILD_PLATFORMS        = linux/amd64,linux/arm64
# 留空 = latest（覆盖式，服务器默认拉这个）；回滚时 pin 精确的 sha-tag（<version>-<git-sha>-<build-ts>）。
COMPOSE_IMAGE_TAG      =

# ---- 镜像加速 ----
# 基础镜像前缀，结尾必须带 `/`（海外构建机传空即回 Docker Hub）。
BUILD_BASE_REGISTRY    = docker.m.daocloud.io/
# Go 模块代理；海外构建机用 https://proxy.golang.org,direct。
GOPROXY                = https://goproxy.cn,direct
# alpine apk 源；海外构建机用 https://dl-cdn.alpinelinux.org/alpine。
APK_MIRROR             = https://mirrors.aliyun.com/alpine
