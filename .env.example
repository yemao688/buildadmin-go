# 部署层变量：make / docker compose 共用；应用 YAML 配置在 configs/config.yaml（不进 .env）。
APP_PORT            = 9900
APP_TIME_ZONE       = Asia/Shanghai
# 启动结构同步模式：off / check / apply（覆盖 app.auto_migrate）。
APP_AUTO_MIGRATE    = apply
COMPOSE_MEM_LIMIT   = 1g

# ---- 镜像推送 ----
COMPOSE_PROJECT_NAME   = buildadmin-go
REGISTRY               = registry.example.com
REGISTRY_NAMESPACE     =
REGISTRY_IMAGE_NAME    = buildadmin-go
REGISTRY_USER          =
REGISTRY_PASSWORD      =
BUILD_PLATFORMS        = linux/amd64,linux/arm64
COMPOSE_IMAGE_TAG      = latest

# ---- 镜像加速 ----
BUILD_BASE_REGISTRY   = docker.m.daocloud.io/
GOPROXY                = https://goproxy.cn,direct
APK_MIRROR             = https://mirrors.aliyun.com/alpine
