# APP_PORT/APP_TIME_ZONE 由应用运行时读取；其余变量为发布机/Compose 变量
# APP_PORT/APP_TIME_ZONE are read by the application at runtime; other variables are for release/Compose.

# 发布机 registry 配置，与应用 YAML 配置分离
DEPLOY_REGISTRY=registry.example.com
DEPLOY_IMAGE_NAME=buildadmin-go
DEPLOY_IMAGE_TAG=latest
DEPLOY_PLATFORMS=linux/amd64,linux/arm64
DEPLOY_REGISTRY_USER=
DEPLOY_REGISTRY_PASSWORD=

# 生产机 Compose 配置：应用配置位于 ./config.yaml
APP_PORT=9989
APP_TIME_ZONE=Asia/Shanghai
